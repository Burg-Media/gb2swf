package tool;

import tool.Sm83;

/**
 * Generates src/gb/Cpu.hx: the SM83 interpreter that runs everything the
 * recompiler did not translate. Run with `gb2swf dev gen-interp` after changing
 * Sm83.hx; the generated file is checked in.
 */
class GenInterp {
	public static function generate():String {
		var out = new StringBuf();
		inline function w(s:String) {
			out.add(s);
			out.add("\n");
		}
		w("// gb2swf - Game Boy ROM to Flash SWF converter");
		w("// Copyright (c) 2026 Burg Media. MIT License, see LICENSE.");
		w("// GENERATED by `gb2swf dev gen-interp` from src/tool/Sm83.hx. Do not edit by hand.");
		w("package gb;");
		w("");
		w("class Cpu extends Machine {");
		w('\tpublic static var LEN:Array<Int> = [${[for (o in 0...256) Sm83.LENGTH[o]].join(", ")}];');
		w("");
		w("\t/** Executes exactly one instruction (the interpreter). */");
		w("\tpublic function step():Void {");
		w("\t\tvar op = rd(pc);");
		w("\t\tif (haltBug) haltBug = false; else pc = (pc + 1) & 0xffff;");
		w("\t\tswitch (op) {");
		for (op in 0...256) {
			var ctx = new InterpCtx(op);
			var body = Sm83.gen(ctx, op);
			var len = op == 0xCB ? 1 : Sm83.LENGTH[op]; // stepCB reads its own second byte
			var pre = "";
			if (len == 2)
				pre = "var n = rd(pc); pc = (pc + 1) & 0xffff; ";
			else if (len == 3)
				pre = "var nn = rd(pc) | (rd((pc + 1) & 0xffff) << 8); pc = (pc + 2) & 0xffff; ";
			var cyc = (op == 0xCB || Sm83.isIllegal(op)) ? "" : 'cycles += ${Sm83.CYC[op] * 4}; ';
			w('\t\t\tcase 0x${StringTools.hex(op, 2)}: // ${op == 0xCB ? "prefix cb" : Sm83.mnemonic(op)}');
			w('\t\t\t\t$cyc$pre$body');
		}
		w("\t\t\tdefault:");
		w("\t\t}");
		w("\t}");
		w("");
		w("\tfunction stepCB():Void {");
		w("\t\tvar op = rd(pc); pc = (pc + 1) & 0xffff;");
		w("\t\tswitch (op) {");
		for (op in 0...256) {
			w('\t\t\tcase 0x${StringTools.hex(op, 2)}: // ${Sm83.mnemonic(0xCB, 0, 0, op)}');
			w('\t\t\t\tcycles += ${Sm83.cbCycles(op) * 4}; ${Sm83.cbop(new InterpCtx(0xCB), op)}');
		}
		w("\t\t\tdefault:");
		w("\t\t}");
		w("\t}");
		w("}");
		return out.toString();
	}
}

class InterpCtx implements Ctx {
	var op:Int;

	public function new(op:Int)
		this.op = op;

	public function n8()
		return "n";

	public function n16()
		return "nn";

	public function next()
		return "pc";

	public function jrTarget()
		return "((pc + ((n ^ 0x80) - 0x80)) & 0xffff)";

	public function rd(a:String, d:Int)
		return d == 0 ? 'rd($a)' : 'rdAt($a, $d)';

	public function wr(a:String, v:String, d:Int)
		return d == 0 ? 'wr($a, $v);' : 'wrAt($a, $v, $d);';

	public function rdIO(n:String)
		return 'rd(0xff00 | $n)';

	public function wrIO(n:String, v:String)
		return 'wr(0xff00 | $n, $v);';

	public function g(name:String)
		return name;

	public function jump(t:String, extra:Int, kind:JumpKind)
		return 'pc = $t;' + (extra != 0 ? ' cycles += $extra;' : "");

	public function cjump(cond:String, t:String, extra:Int)
		return 'if ($cond) { cycles += $extra; pc = $t; }';

	public function ccall(cond:String, t:String, pushCode:String, extra:Int)
		return 'if ($cond) { cycles += $extra; $pushCode pc = $t; }';

	public function cret(cond:String, popCode:String, v:String, extra:Int)
		return 'if ($cond) { cycles += $extra; $popCode pc = $v; }';

	public function halt()
		return "halt();";

	public function stop()
		return "stop();";

	public function illegal()
		return 'illegal($op);';

	public function cb()
		return "stepCB();";
}
