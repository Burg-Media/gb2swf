package tool;

import haxe.io.Bytes;

/**
 * Writes the HTML player folder: the page, Ruffle, the audio bridge and the game.
 *
 * Browsers refuse fetch() on file:// URLs, which is how Ruffle normally loads its
 * WebAssembly and the SWF. So both are also stored inside .js files (base64,
 * the wasm gzip-compressed); the page hands them to Ruffle directly. That way the
 * same folder works when opened from disk and when uploaded to a web server.
 */
class Player {
	static inline var WASM = "ruffle_web-wasm_mvp_bg.wasm";

	public static function write(dir:String, swf:String, name:String, title:String) {
		var tpl = Host.join(Host.root(), "player");
		if (!Host.exists(Host.join(tpl, "ruffle/ruffle.js")))
			throw "the player template is missing (" + tpl + "/ruffle/ruffle.js)";
		Host.remove(dir);
		Host.mkdir(Host.join(dir, "ruffle"));
		for (f in ["gb2swf-player.js", "gb2swf-audio.js", "gb2swf-player.css"])
			Host.copy(Host.join(tpl, f), Host.join(dir, f));
		for (f in Host.list(Host.join(tpl, "ruffle")))
			if (f == "ruffle.js" || StringTools.startsWith(f, "LICENSE") || f == "README.md")
				Host.copy(Host.join(tpl, "ruffle/" + f), Host.join(dir, "ruffle/" + f));
		Host.writeText(Host.join(dir, "ruffle/ruffle-wasm.js"), wasmScript(tpl));

		var html = Host.readText(Host.join(tpl, "index.html"));
		html = StringTools.replace(html, "{{TITLE}}", StringTools.htmlEscape(title, true));
		Host.writeText(Host.join(dir, "index.html"), html);

		var data = Host.readBytes(swf);
		var meta = haxe.Json.stringify({name: name, title: title, file: name + ".swf"});
		Host.writeText(Host.join(dir, "game.js"),
			"// Generated by gb2swf: the game as data, so that the player also works from file://\n"
			+ 'window.GB2SWF_GAME = $meta;\nwindow.GB2SWF_GAME.swf = "${haxe.crypto.Base64.encode(data)}";\n');
		// The SWF itself as well, for the Flash Player projector or other players
		Host.copy(swf, Host.join(dir, name + ".swf"));
	}

	/** Creates the cached player/ruffle/ruffle-wasm.js (release packages ship it instead of the .wasm). */
	public static function prepare()
		wasmScript(Host.join(Host.root(), "player"));

	/** ruffle-wasm.js: the Ruffle WebAssembly module, gzip + base64. Cached in the template folder. */
	static function wasmScript(tpl:String):String {
		var cached = Host.join(tpl, "ruffle/ruffle-wasm.js");
		if (Host.exists(cached))
			return Host.readText(cached);
		var wasm:String = null;
		for (f in Host.list(Host.join(tpl, "ruffle")))
			if (StringTools.startsWith(f, "ruffle_web-wasm_mvp_bg") && StringTools.endsWith(f, ".wasm"))
				wasm = Host.join(tpl, "ruffle/" + f);
		if (wasm == null)
			throw "Ruffle's " + WASM + " is missing in " + tpl + "/ruffle";
		var gz = Host.gzip(Host.readBytes(wasm));
		var js = "// Ruffle (https://ruffle.rs, MIT OR Apache-2.0): WebAssembly module, gzip + base64\n"
			+ 'window.GB2SWF_RUFFLE_WASM = "${haxe.crypto.Base64.encode(gz)}";\n';
		try {
			Host.writeText(cached, js);
		} catch (e:Dynamic) {} // read-only installation: just don't cache
		return js;
	}
}
