package tool;

/**
 * Code generation context. The same instruction semantics (Sm83.gen) are written
 * out twice: once for the interpreter (src/gb/Cpu.hx, generated by GenInterp) and
 * once per basic block by the Recompiler. The context decides how immediates,
 * memory accesses and jumps are spelled.
 *
 * Memory accesses take `d`: the number of T-cycles between the access and the end
 * of the instruction. The instruction's full cycle count is added before its body
 * runs, so an access with d > 0 is made "in the past" (see Machine.rdAt/wrAt). This
 * gives every read and write the M-cycle timing of the real CPU.
 */
interface Ctx {
	function n8():String;
	function n16():String;
	function next():String;
	function jrTarget():String;
	function rd(a:String, d:Int):String;
	function wr(a:String, v:String, d:Int):String;
	function rdIO(n:String):String;
	function wrIO(n:String, v:String):String;
	function g(name:String):String;
	function jump(t:String, extra:Int, kind:JumpKind):String;
	function cjump(cond:String, t:String, extra:Int):String;
	function ccall(cond:String, t:String, pushCode:String, extra:Int):String;
	function cret(cond:String, popCode:String, v:String, extra:Int):String;
	function halt():String;
	function stop():String;
	function illegal():String;
	function cb():String;
}

enum JumpKind {
	Plain;
	Call;
	Ret;
}

enum Flow {
	Next;
	Jump;
	Cond;
	Call;
	CondCall;
	Ret;
	CondRet;
	Stop;
}

/**
 * The SM83 (Game Boy CPU) instruction set as Haxe source fragments.
 * Registers and flags in generated code: a b c d e h l sp, fz fn fh fc (Bool).
 * Machine fields (ime, halted, ...) always go through ctx.g(name).
 */
class Sm83 {
	public static final R8 = ["b", "c", "d", "e", "h", "l", "(hl)", "a"];
	public static final R16 = ["bc", "de", "hl", "sp"];
	public static final R16STK = ["bc", "de", "hl", "af"];
	public static final CONDS = ["nz", "z", "nc", "c"];
	public static final ALU = ["add", "adc", "sub", "sbc", "and", "xor", "or", "cp"];
	public static final CBOPS = ["rlc", "rrc", "rl", "rr", "sla", "sra", "swap", "srl"];
	public static final ILLEGAL = [0xD3, 0xDB, 0xDD, 0xE3, 0xE4, 0xEB, 0xEC, 0xED, 0xF4, 0xFC, 0xFD];

	static inline var HL = "((h << 8) | l)";
	static inline var F_EXPR = "((fz ? 0x80 : 0) | (fn ? 0x40 : 0) | (fh ? 0x20 : 0) | (fc ? 0x10 : 0))";

	/** Base M-cycles (not-taken variant) of the unprefixed opcodes. */
	public static final CYC:Array<Int> = makeCycles();

	/** Instruction length in bytes. */
	public static final LENGTH:Array<Int> = makeLengths();

	static function makeCycles():Array<Int> {
		var c = [
			1, 3, 2, 2, 1, 1, 2, 1, 5, 2, 2, 2, 1, 1, 2, 1,
			1, 3, 2, 2, 1, 1, 2, 1, 3, 2, 2, 2, 1, 1, 2, 1,
			2, 3, 2, 2, 1, 1, 2, 1, 2, 2, 2, 2, 1, 1, 2, 1,
			2, 3, 2, 2, 3, 3, 3, 1, 2, 2, 2, 2, 1, 1, 2, 1
		];
		for (op in 0x40...0xC0) {
			var src = op & 7, dst = (op >> 3) & 7;
			if (op < 0x80)
				c.push((src == 6 || dst == 6) && op != 0x76 ? 2 : 1);
			else
				c.push(src == 6 ? 2 : 1);
		}
		for (v in [
			2, 3, 3, 4, 3, 4, 2, 4, 2, 4, 3, 1, 3, 6, 2, 4,
			2, 3, 3, 0, 3, 4, 2, 4, 2, 4, 3, 0, 3, 0, 2, 4,
			3, 3, 2, 0, 0, 4, 2, 4, 4, 1, 4, 0, 0, 0, 2, 4,
			3, 3, 2, 1, 0, 4, 2, 4, 3, 2, 4, 1, 0, 0, 2, 4
		])
			c.push(v);
		return c;
	}

	static function makeLengths():Array<Int> {
		var l = [for (i in 0...256) 1];
		for (op in [
			0x06, 0x0E, 0x16, 0x1E, 0x26, 0x2E, 0x36, 0x3E, 0x10, 0x18, 0x20, 0x28, 0x30, 0x38, 0xC6, 0xCE, 0xD6, 0xDE, 0xE6, 0xEE, 0xF6,
			0xFE, 0xE0, 0xF0, 0xE8, 0xF8, 0xCB
		])
			l[op] = 2;
		for (op in [0x01, 0x11, 0x21, 0x31, 0x08, 0xC2, 0xC3, 0xCA, 0xD2, 0xDA, 0xC4, 0xCC, 0xCD, 0xD4, 0xDC, 0xEA, 0xFA])
			l[op] = 3;
		return l;
	}

	/** M-cycles of a CB-prefixed instruction (including the prefix). */
	public static function cbCycles(cbop:Int):Int {
		if ((cbop & 7) != 6)
			return 2;
		return (cbop >= 0x40 && cbop < 0x80) ? 3 : 4;
	}

	public static function isIllegal(op:Int):Bool
		return ILLEGAL.indexOf(op) >= 0;

	/** Kind of control flow, used by the recompiler to end basic blocks. */
	public static function flow(op:Int):Flow {
		if (op == 0x18 || op == 0xC3 || op == 0xE9)
			return Jump;
		if (op == 0x20 || op == 0x28 || op == 0x30 || op == 0x38 || op == 0xC2 || op == 0xCA || op == 0xD2 || op == 0xDA)
			return Cond;
		if (op == 0xC4 || op == 0xCC || op == 0xD4 || op == 0xDC)
			return CondCall;
		if (op == 0xCD || (op & 0xC7) == 0xC7)
			return Call;
		if (op == 0xC9 || op == 0xD9)
			return Ret;
		if (op == 0xC0 || op == 0xC8 || op == 0xD0 || op == 0xD8)
			return CondRet;
		if (op == 0x76 || op == 0x10 || op == 0xFB || isIllegal(op))
			return Stop;
		return Next;
	}

	/** Target of a jump or call with a constant destination, or -1. */
	public static function staticTarget(op:Int, addr:Int, imm:Int):Int {
		if (op == 0x18 || op == 0x20 || op == 0x28 || op == 0x30 || op == 0x38)
			return (addr + 2 + ((imm ^ 0x80) - 0x80)) & 0xFFFF;
		if (op == 0xC3 || op == 0xC2 || op == 0xCA || op == 0xD2 || op == 0xDA || op == 0xCD || op == 0xC4 || op == 0xCC || op == 0xD4
			|| op == 0xDC)
			return imm;
		if ((op & 0xC7) == 0xC7)
			return op & 0x38;
		return -1;
	}

	static function condExpr(c:String):String {
		return switch (c) {
			case "nz": "!fz";
			case "z": "fz";
			case "nc": "!fc";
			default: "fc";
		}
	}

	// ------------------------------------------------------------------ helpers

	static function get8(ctx:Ctx, r:String, d:Int):String
		return r == "(hl)" ? ctx.rd(HL, d) : r;

	static function set8(ctx:Ctx, r:String, v:String, d:Int):String
		return r == "(hl)" ? ctx.wr(HL, v, d) : '$r = $v;';

	static function get16(r:String):String {
		if (r == "sp")
			return "sp";
		if (r == "af")
			return '((a << 8) | $F_EXPR)';
		return '((${r.charAt(0)} << 8) | ${r.charAt(1)})';
	}

	/** `v` must be a simple expression (it is used more than once). */
	static function set16(r:String, v:String):String {
		if (r == "sp")
			return 'sp = $v;';
		if (r == "af")
			return 'a = ($v) >> 8; fz = (($v) & 0x80) != 0; fn = (($v) & 0x40) != 0; fh = (($v) & 0x20) != 0; fc = (($v) & 0x10) != 0;';
		return '${r.charAt(0)} = ($v) >> 8; ${r.charAt(1)} = ($v) & 0xff;';
	}

	/** Push: high byte d=4, low byte d=0 (the last two M-cycles). */
	static function push(ctx:Ctx, v:String):String {
		return '{ var _p = $v; sp = (sp - 1) & 0xffff; ${ctx.wr("sp", "_p >> 8", 4)} sp = (sp - 1) & 0xffff; ${ctx.wr("sp", "_p & 0xff", 0)} }';
	}

	static function popInto(ctx:Ctx, v:String, dLo:Int, dHi:Int):String {
		return 'var $v = ${ctx.rd("sp", dLo)}; sp = (sp + 1) & 0xffff; $v |= ${ctx.rd("sp", dHi)} << 8; sp = (sp + 1) & 0xffff;';
	}

	static function alu(kind:String, v:String):String {
		var pre = 'var _v = $v;';
		return switch (kind) {
			case "add": '{ $pre var _r = a + _v; fh = ((a & 0xf) + (_v & 0xf)) > 0xf; fc = _r > 0xff; a = _r & 0xff; fz = a == 0; fn = false; }';
			case "adc": '{ $pre var _ci = fc ? 1 : 0; var _r = a + _v + _ci; fh = ((a & 0xf) + (_v & 0xf) + _ci) > 0xf; fc = _r > 0xff; a = _r & 0xff; fz = a == 0; fn = false; }';
			case "sub": '{ $pre var _r = a - _v; fh = (a & 0xf) < (_v & 0xf); fc = _r < 0; a = _r & 0xff; fz = a == 0; fn = true; }';
			case "sbc": '{ $pre var _ci = fc ? 1 : 0; var _r = a - _v - _ci; fh = ((a & 0xf) - (_v & 0xf) - _ci) < 0; fc = _r < 0; a = _r & 0xff; fz = a == 0; fn = true; }';
			case "and": '{ $pre a &= _v; fz = a == 0; fn = false; fh = true; fc = false; }';
			case "xor": '{ $pre a ^= _v; fz = a == 0; fn = false; fh = false; fc = false; }';
			case "or": '{ $pre a |= _v; fz = a == 0; fn = false; fh = false; fc = false; }';
			case "cp": '{ $pre var _r = a - _v; fh = (a & 0xf) < (_v & 0xf); fc = _r < 0; fz = _r == 0; fn = true; }';
			default: throw kind;
		}
	}

	static function incdec(ctx:Ctx, r:String, inc:Bool):String {
		var fl = inc ? "fz = _r == 0; fn = false; fh = (_r & 0xf) == 0;" : "fz = _r == 0; fn = true; fh = (_r & 0xf) == 0xf;";
		var calc = inc ? "+ 1" : "- 1";
		if (r == "(hl)")
			return '{ var _a = $HL; var _r = (${ctx.rd("_a", 4)} $calc) & 0xff; ${ctx.wr("_a", "_r", 0)} $fl }';
		return '{ var _r = ($r $calc) & 0xff; $r = _r; $fl }';
	}

	/** CB-prefixed instruction `op` (the second byte). */
	public static function cbop(ctx:Ctx, op:Int):String {
		var kind = op >> 6;
		var bit = (op >> 3) & 7;
		var r = R8[op & 7];
		var load, store;
		if (r == "(hl)") {
			// BIT n,(hl) reads in its last M-cycle; read-modify-write reads one cycle before the write
			load = 'var _a = $HL; var _v = ${ctx.rd("_a", kind == 1 ? 0 : 4)};';
			store = ctx.wr("_a", "_r", 0);
		} else {
			load = 'var _v = $r;';
			store = '$r = _r;';
		}
		if (kind == 1)
			return '{ $load fz = (_v & ${1 << bit}) == 0; fn = false; fh = true; }';
		if (kind == 2)
			return '{ $load var _r = _v & ${0xFF ^ (1 << bit)}; $store }';
		if (kind == 3)
			return '{ $load var _r = _v | ${1 << bit}; $store }';
		var body = switch (CBOPS[bit]) {
			case "rlc": "fc = (_v & 0x80) != 0; var _r = ((_v << 1) | (_v >> 7)) & 0xff;";
			case "rrc": "fc = (_v & 1) != 0; var _r = ((_v >> 1) | (_v << 7)) & 0xff;";
			case "rl": "var _r = ((_v << 1) | (fc ? 1 : 0)) & 0xff; fc = (_v & 0x80) != 0;";
			case "rr": "var _r = (_v >> 1) | (fc ? 0x80 : 0); fc = (_v & 1) != 0;";
			case "sla": "fc = (_v & 0x80) != 0; var _r = (_v << 1) & 0xff;";
			case "sra": "fc = (_v & 1) != 0; var _r = (_v >> 1) | (_v & 0x80);";
			case "swap": "var _r = ((_v & 0xf) << 4) | (_v >> 4); fc = false;";
			default: "fc = (_v & 1) != 0; var _r = _v >> 1;";
		}
		return '{ $load $body fz = _r == 0; fn = false; fh = false; $store }';
	}

	/**
	 * Haxe code for unprefixed opcode `op`, without the base cycles (the caller adds
	 * those). For 0xCB the context supplies the second byte through ctx.cb().
	 */
	public static function gen(ctx:Ctx, op:Int):String {
		if (op >= 0x40 && op < 0x80) {
			if (op == 0x76)
				return ctx.halt();
			var dst = R8[(op >> 3) & 7], src = R8[op & 7];
			if (dst == src)
				return "";
			return set8(ctx, dst, get8(ctx, src, 0), 0);
		}
		if (op >= 0x80 && op < 0xC0)
			return alu(ALU[(op >> 3) & 7], get8(ctx, R8[op & 7], 0));
		if ((op & 0xC7) == 0xC6)
			return alu(ALU[(op >> 3) & 7], ctx.n8());
		if (op < 0x40) {
			switch (op & 7) {
				case 4:
					return incdec(ctx, R8[op >> 3], true);
				case 5:
					return incdec(ctx, R8[op >> 3], false);
				case 6:
					return set8(ctx, R8[op >> 3], ctx.n8(), 0);
				default:
			}
			var r = R16[op >> 4];
			switch (op & 0xF) {
				case 1:
					return '{ var _n = ${ctx.n16()}; ${set16(r, "_n")} }';
				case 3:
					if (r == "sp")
						return "sp = (sp + 1) & 0xffff;";
					var hi = r.charAt(0), lo = r.charAt(1);
					return '$lo = ($lo + 1) & 0xff; if ($lo == 0) $hi = ($hi + 1) & 0xff;';
				case 0xB:
					if (r == "sp")
						return "sp = (sp - 1) & 0xffff;";
					var hi = r.charAt(0), lo = r.charAt(1);
					return '$lo = ($lo - 1) & 0xff; if ($lo == 0xff) $hi = ($hi - 1) & 0xff;';
				case 9:
					return '{ var _hl = $HL; var _v = ${get16(r)}; var _r = _hl + _v; fh = ((_hl & 0xfff) + (_v & 0xfff)) > 0xfff; fc = _r > 0xffff; fn = false; h = (_r >> 8) & 0xff; l = _r & 0xff; }';
				default:
			}
		}
		if (op == 0xC1 || op == 0xD1 || op == 0xE1 || op == 0xF1)
			return '{ ${popInto(ctx, "_w", 4, 0)} ${set16(R16STK[(op >> 4) - 0xC], "_w")} }';
		if (op == 0xC5 || op == 0xD5 || op == 0xE5 || op == 0xF5)
			return push(ctx, get16(R16STK[(op >> 4) - 0xC]));

		switch (op) {
			case 0x00:
				return "";
			case 0x02:
				return ctx.wr("((b << 8) | c)", "a", 0);
			case 0x12:
				return ctx.wr("((d << 8) | e)", "a", 0);
			case 0x0A:
				return 'a = ${ctx.rd("((b << 8) | c)", 0)};';
			case 0x1A:
				return 'a = ${ctx.rd("((d << 8) | e)", 0)};';
			case 0x22, 0x32, 0x2A, 0x3A:
				var step = (op == 0x22 || op == 0x2A) ? "+ 1" : "- 1";
				var acc = (op == 0x22 || op == 0x32) ? ctx.wr("_a", "a", 0) : 'a = ${ctx.rd("_a", 0)};';
				return '{ var _a = $HL; $acc _a = (_a $step) & 0xffff; h = _a >> 8; l = _a & 0xff; }';
			case 0x07:
				return "fc = (a & 0x80) != 0; a = ((a << 1) | (a >> 7)) & 0xff; fz = false; fn = false; fh = false;";
			case 0x0F:
				return "fc = (a & 1) != 0; a = ((a >> 1) | (a << 7)) & 0xff; fz = false; fn = false; fh = false;";
			case 0x17:
				return "{ var _c = fc ? 1 : 0; fc = (a & 0x80) != 0; a = ((a << 1) | _c) & 0xff; fz = false; fn = false; fh = false; }";
			case 0x1F:
				return "{ var _c = fc ? 0x80 : 0; fc = (a & 1) != 0; a = (a >> 1) | _c; fz = false; fn = false; fh = false; }";
			case 0x27:
				return "{ var _a = a; if (!fn) { if (fc || _a > 0x99) { _a += 0x60; fc = true; } "
					+ "if (fh || (_a & 0x0f) > 0x09) _a += 0x06; } else { if (fc) _a -= 0x60; if (fh) _a -= 0x06; } "
					+ "a = _a & 0xff; fz = a == 0; fh = false; }";
			case 0x2F:
				return "a ^= 0xff; fn = true; fh = true;";
			case 0x37:
				return "fc = true; fn = false; fh = false;";
			case 0x3F:
				return "fc = !fc; fn = false; fh = false;";
			case 0x08:
				return '{ var _a = ${ctx.n16()}; ${ctx.wr("_a", "sp & 0xff", 4)} ${ctx.wr("(_a + 1) & 0xffff", "sp >> 8", 0)} }';
			case 0x10:
				return ctx.stop();
			case 0x18:
				return ctx.jump(ctx.jrTarget(), 0, Plain);
			case 0x20, 0x28, 0x30, 0x38:
				return ctx.cjump(condExpr(CONDS[(op >> 3) & 3]), ctx.jrTarget(), 4);
			case 0xC3:
				return ctx.jump(ctx.n16(), 0, Plain);
			case 0xC2, 0xCA, 0xD2, 0xDA:
				return ctx.cjump(condExpr(CONDS[(op >> 3) & 3]), ctx.n16(), 4);
			case 0xE9:
				return ctx.jump(HL, 0, Plain);
			case 0xCD:
				return push(ctx, ctx.next()) + " " + ctx.jump(ctx.n16(), 0, Call);
			case 0xC4, 0xCC, 0xD4, 0xDC:
				return ctx.ccall(condExpr(CONDS[(op >> 3) & 3]), ctx.n16(), push(ctx, ctx.next()), 12);
			case 0xC9:
				return '{ ${popInto(ctx, "_w", 8, 4)} ${ctx.jump("_w", 0, Ret)} }';
			case 0xD9:
				return '{ ${popInto(ctx, "_w", 8, 4)} ${ctx.g("ime")} = true; ${ctx.jump("_w", 0, Ret)} }';
			case 0xC0, 0xC8, 0xD0, 0xD8:
				return ctx.cret(condExpr(CONDS[(op >> 3) & 3]), popInto(ctx, "_w", 8, 4), "_w", 12);
			case 0xE0:
				return ctx.wrIO(ctx.n8(), "a");
			case 0xF0:
				return 'a = ${ctx.rdIO(ctx.n8())};';
			case 0xE2:
				return ctx.wr("0xff00 | c", "a", 0);
			case 0xF2:
				return 'a = ${ctx.rd("0xff00 | c", 0)};';
			case 0xEA:
				return ctx.wr(ctx.n16(), "a", 0);
			case 0xFA:
				return 'a = ${ctx.rd(ctx.n16(), 0)};';
			case 0xE8, 0xF8:
				var dst = op == 0xE8 ? "sp = _r & 0xffff;" : "h = (_r >> 8) & 0xff; l = _r & 0xff;";
				return '{ var _n = ${ctx.n8()}; var _r = sp + ((_n ^ 0x80) - 0x80); fz = false; fn = false; fh = ((sp & 0xf) + (_n & 0xf)) > 0xf; fc = ((sp & 0xff) + _n) > 0xff; $dst }';
			case 0xF9:
				return 'sp = $HL;';
			case 0xF3:
				return '${ctx.g("ime")} = false; ${ctx.g("imeDelay")} = false;';
			case 0xFB:
				return '${ctx.g("imeDelay")} = true;';
			case 0xCB:
				return ctx.cb();
			default:
		}
		if ((op & 0xC7) == 0xC7)
			return push(ctx, ctx.next()) + " " + ctx.jump(Std.string(op & 0x38), 0, Call);
		if (isIllegal(op))
			return ctx.illegal();
		throw "unknown opcode " + StringTools.hex(op, 2);
	}

	// ------------------------------------------------------------------ disassembly (for comments)

	static function hx(v:Int, n:Int = 2):String
		return "$" + StringTools.hex(v, n).toLowerCase();

	static function regName(r:String):String
		return r == "(hl)" ? "[hl]" : r;

	/** Readable assembly, used for comments in generated code. */
	public static function mnemonic(op:Int, imm:Int = 0, addr:Int = 0, cb:Int = 0):String {
		if (op == 0xCB) {
			var k = cb >> 6;
			var r = regName(R8[cb & 7]);
			if (k == 0)
				return '${CBOPS[(cb >> 3) & 7]} $r';
			return '${["", "bit", "res", "set"][k]} ${(cb >> 3) & 7}, $r';
		}
		if (op >= 0x40 && op < 0x80)
			return op == 0x76 ? "halt" : 'ld ${regName(R8[(op >> 3) & 7])}, ${regName(R8[op & 7])}';
		if (op >= 0x80 && op < 0xC0)
			return '${ALU[(op >> 3) & 7]} a, ${regName(R8[op & 7])}';
		if ((op & 0xC7) == 0xC6)
			return '${ALU[(op >> 3) & 7]} a, ${hx(imm)}';
		var t = staticTarget(op, addr, imm);
		var names = [
			0x00 => "nop", 0x07 => "rlca", 0x0F => "rrca", 0x17 => "rla", 0x1F => "rra", 0x27 => "daa", 0x2F => "cpl", 0x37 => "scf", 0x3F => "ccf",
			0x10 => "stop", 0xF3 => "di", 0xFB => "ei", 0xC9 => "ret", 0xD9 => "reti", 0xE9 => "jp hl", 0xF9 => "ld sp, hl", 0x02 => "ld [bc], a",
			0x12 => "ld [de], a", 0x0A => "ld a, [bc]", 0x1A => "ld a, [de]", 0x22 => "ld [hl+], a", 0x32 => "ld [hl-], a", 0x2A => "ld a, [hl+]",
			0x3A => "ld a, [hl-]", 0xE2 => "ld [c], a", 0xF2 => "ld a, [c]"
		];
		if (names.exists(op))
			return names.get(op);
		if (op < 0x40) {
			var lo = op & 0xF;
			switch (op & 7) {
				case 4:
					return 'inc ${regName(R8[op >> 3])}';
				case 5:
					return 'dec ${regName(R8[op >> 3])}';
				case 6:
					return 'ld ${regName(R8[op >> 3])}, ${hx(imm)}';
				default:
			}
			if (lo == 1)
				return 'ld ${R16[op >> 4]}, ${hx(imm, 4)}';
			if (lo == 3)
				return 'inc ${R16[op >> 4]}';
			if (lo == 0xB)
				return 'dec ${R16[op >> 4]}';
			if (lo == 9)
				return 'add hl, ${R16[op >> 4]}';
			if (op == 0x08)
				return 'ld [${hx(imm, 4)}], sp';
			if (op == 0x18)
				return 'jr ${hx(t, 4)}';
			if (op == 0x20 || op == 0x28 || op == 0x30 || op == 0x38)
				return 'jr ${CONDS[(op >> 3) & 3]}, ${hx(t, 4)}';
		}
		if (op == 0xC1 || op == 0xD1 || op == 0xE1 || op == 0xF1)
			return 'pop ${R16STK[(op >> 4) - 0xC]}';
		if (op == 0xC5 || op == 0xD5 || op == 0xE5 || op == 0xF5)
			return 'push ${R16STK[(op >> 4) - 0xC]}';
		if (op == 0xC3)
			return 'jp ${hx(t, 4)}';
		if (op == 0xC2 || op == 0xCA || op == 0xD2 || op == 0xDA)
			return 'jp ${CONDS[(op >> 3) & 3]}, ${hx(t, 4)}';
		if (op == 0xCD)
			return 'call ${hx(t, 4)}';
		if (op == 0xC4 || op == 0xCC || op == 0xD4 || op == 0xDC)
			return 'call ${CONDS[(op >> 3) & 3]}, ${hx(t, 4)}';
		if ((op & 0xC7) == 0xC7)
			return 'rst ${hx(op & 0x38)}';
		if (op == 0xC0 || op == 0xC8 || op == 0xD0 || op == 0xD8)
			return 'ret ${CONDS[(op >> 3) & 3]}';
		if (op == 0xE0)
			return 'ldh [${hx(0xff00 | imm, 4)}], a';
		if (op == 0xF0)
			return 'ldh a, [${hx(0xff00 | imm, 4)}]';
		if (op == 0xEA)
			return 'ld [${hx(imm, 4)}], a';
		if (op == 0xFA)
			return 'ld a, [${hx(imm, 4)}]';
		if (op == 0xE8)
			return 'add sp, ${(imm ^ 0x80) - 0x80}';
		if (op == 0xF8) {
			var e = (imm ^ 0x80) - 0x80;
			return 'ld hl, sp${e >= 0 ? "+" : ""}$e';
		}
		return 'db ${hx(op)}';
	}
}
